# Legacy/local cache toggles. Keep false for the durable production desk.
NEXT_PUBLIC_USE_RSS_CACHE=false
NEXT_PUBLIC_USE_MERGED_STORIES=false
NEXT_PUBLIC_SHOW_LIVE_BETA=false

# Supabase/Postgres backend. Required for durable stories, feed inbox, and automation.
# Prefer the current sb_secret_... server key. Legacy service_role remains supported as fallback.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Admin bearer token for editorial APIs and /admin tools.
# ADMIN_API_TOKEN=

# Shared secret accepted by protected ingest/automation endpoints when invoked by a scheduler.
# CRON_SECRET=

# Development-only safety fallback. Leave false/unset in deployed environments.
# ALLOW_MOCK_FALLBACK=false

# Optional non-legacy discovery lane. Social signals are discovery evidence only;
# they never count as independent publisher corroboration or automatic lead evidence.
# No X request occurs unless the feature flag and server-side bearer token are present.
# FACT_DESK_SOCIAL_SIGNALS=0
# FACT_DESK_X_BEARER_TOKEN=
# FACT_DESK_X_NEWS_QUERIES=breaking news,politics,markets,technology,health
# FACT_DESK_MASTODON_TAGS=

# Optional admin-only AI Draft Assist. Build works without these.
# AI_DRAFT_ASSIST_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Automation mode. Use auto_draft for the controlled pilot; guarded auto-publish remains experimental.
# FACT_DESK_AUTOMATION_MODE=manual_review
# FACT_DESK_HEALTH_AUTO_PUBLISH_ENABLED=false

# Optional Supabase integration test project. Never point these at production.
# RUN_INTEGRATION_TESTS=false
# SUPABASE_TEST_URL=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
# SUPABASE_TEST_ALLOW_REMOTE=false
# SUPABASE_TEST_ALLOW_SHARED_DATABASE=false
