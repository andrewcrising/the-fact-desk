# Mock homepage (default)
NEXT_PUBLIC_USE_RSS_CACHE=false
NEXT_PUBLIC_USE_MERGED_STORIES=false

# Live Beta Feed — fetches RSS on server (15 min cache). Set true on Vercel for live data.
NEXT_PUBLIC_SHOW_LIVE_BETA=false

# Original evidence synthesis. Vercel deployments can authenticate to AI
# Gateway with OIDC. For local runs, supply AI_GATEWAY_API_KEY or leave unset
# to use the deterministic, attribution-only fallback.
FACT_DESK_SYNTHESIS_ENABLED=true
FACT_DESK_SYNTHESIS_MODEL=openai/gpt-5.4-nano
# AI_GATEWAY_API_KEY=

# Vercel Cron auth for /api/cron/revalidate-live (Vercel may auto-set on Pro; set manually if needed)
# CRON_SECRET=

# Reader-support launch links. Leave unset until the destination accounts are
# configured and tested; the public site will not simulate signup or payment.
# NEXT_PUBLIC_BRIEFING_SIGNUP_URL=
# NEXT_PUBLIC_SUPPORT_URL=
