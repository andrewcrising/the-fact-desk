# Mock homepage (default)
NEXT_PUBLIC_USE_RSS_CACHE=false
NEXT_PUBLIC_USE_MERGED_STORIES=false

# Live Beta Feed — fetches RSS on server (15 min cache). Set true on Vercel for live data.
NEXT_PUBLIC_SHOW_LIVE_BETA=false

# Vercel Cron auth for /api/cron/revalidate-live (Vercel may auto-set on Pro; set manually if needed)
# CRON_SECRET=
