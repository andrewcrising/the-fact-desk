# Mock homepage (default)
NEXT_PUBLIC_USE_RSS_CACHE=false
NEXT_PUBLIC_USE_MERGED_STORIES=false

# Live Beta Feed — fetches RSS on server (15 min cache). Set true on Vercel for live data.
NEXT_PUBLIC_SHOW_LIVE_BETA=false

# Supabase/Postgres MVP backend. Required for durable stories, feed inbox, and newsletter signup.
# Prefer the current sb_secret_... key. Legacy service_role remains supported as fallback.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Admin bearer token for editorial APIs and /admin tools.
# ADMIN_API_TOKEN=

# Vercel Cron auth for /api/ingest/rss and /api/cron/revalidate-live.
# CRON_SECRET=

# Development-only safety fallback. Leave false/unset in production.
# ALLOW_MOCK_FALLBACK=false

# Optional admin-only AI Draft Assist. Build works without these.
# AI_DRAFT_ASSIST_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Automation mode. Default is manual_review. guarded_auto_publish is experimental.
# FACT_DESK_AUTOMATION_MODE=manual_review
# FACT_DESK_HEALTH_AUTO_PUBLISH_ENABLED=false

# Optional Supabase integration test project. Never point these at production.
# RUN_INTEGRATION_TESTS=false
# SUPABASE_TEST_URL=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
# SUPABASE_TEST_ALLOW_REMOTE=false
# SUPABASE_TEST_ALLOW_SHARED_DATABASE=false
